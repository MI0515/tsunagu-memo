# このファイルをコピーして .env.local という名前にし、値を入れて使います。
# .env.local は Git に入りません（秘密を守るため）。このファイルには値を書かないでください。

# --- ブラウザに渡してよい値（公開されても大丈夫なもの） ---
# Supabase の Project Settings → API Keys で確認
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile のサイトキー
# 開発中（demo）は、Cloudflare 公式のテスト用キー 1x00000000000000000000AA を使う（必ず合格になる）。
# その時の Supabase（Authentication → Attack Protection）の Captcha secret は 1x0000000000000000000000000000000AA。
# 本番では、Cloudflare で作った本物のキーに差し替える。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# production か demo
NEXT_PUBLIC_APP_MODE=production

# --- 秘密の値（ブラウザに出さない・人に見せない・チャットに貼らない） ---
# Supabase の Project Settings → API Keys → Secret keys（keep-alive と整理の処理だけが使う）
SUPABASE_SECRET_KEY=
# 定期実行の合言葉。ランダムな長い文字列（例：openssl rand -hex 32 で作る）
CRON_SECRET=
