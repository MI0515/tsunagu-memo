# このファイルをコピーして .env.local という名前にし、値を入れて使います。
# .env.local は Git に入りません（秘密を守るため）。このファイルには値を書かないでください。

# --- ブラウザに渡してよい値（公開されても大丈夫なもの） ---
# Supabase の Project Settings → API Keys で確認
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile のサイトキー
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# production か demo
NEXT_PUBLIC_APP_MODE=production

# --- 秘密の値（ブラウザに出さない・人に見せない・チャットに貼らない） ---
SUPABASE_SECRET_KEY=
CRON_SECRET=
